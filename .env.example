# ─── CuraBook — Root Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your values.
# This file is read by docker-compose for ALL services.
# ──────────────────────────────────────────────────────────────────────────────

# ── Django ─────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets-module
DJANGO_SETTINGS_MODULE=curabook.settings.prod
DEBUG=False

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
DB_NAME=curabook_db
DB_USER=curabook_user
DB_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@curabook.com
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=CuraBook <noreply@curabook.com>

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── CORS — Production domain (comma separated if multiple) ────────────────────
CORS_ALLOWED_ORIGINS=https://curabook.com,https://www.curabook.com
CSRF_TRUSTED_ORIGINS=https://curabook.com,https://www.curabook.com
ALLOWED_HOSTS=curabook.com,www.curabook.com,web
DOMAIN=curabook.com

# ── File Storage ───────────────────────────────────────────────────────────────
USE_S3=False
# Uncomment and fill if USE_S3=True:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1

# ── Monitoring ─────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=change-me

# ── Frontend (injected at build time via docker-compose) ──────────────────────
REACT_APP_API_URL=https://curabook.com/api/v1
REACT_APP_WS_URL=wss://curabook.com/ws
REACT_APP_NAME=CuraBook
REACT_APP_VERSION=1.0.0

# ── File Storage (S3 / MinIO) ──────────────────────────────────────────────────
# STORAGE_BACKEND options: local | s3 | minio
# 'local' stores files on-disk (MEDIA_ROOT) — safe for dev.
# 's3' or 'minio' activates storages.backends.s3boto3.S3Boto3Storage in prod.
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_STORAGE_BUCKET_NAME=curabook-media
AWS_S3_REGION_NAME=us-east-1
# For MinIO self-hosted (leave blank for AWS S3):
# AWS_S3_ENDPOINT_URL=http://minio:9000

# ── Sentry error monitoring (REQUIRED in production — get DSN from sentry.io) ─
# Create a project at https://sentry.io → Settings → Client Keys → DSN
# Leave blank to disable (NOT recommended for production).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.05
GIT_COMMIT_SHA=unknown

# ── SMS Provider ───────────────────────────────────────────────────────────────
# SMS_PROVIDER options: console | twilio | vonage
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+12025551234
# VONAGE_API_KEY=
# VONAGE_API_SECRET=
# VONAGE_FROM_NAME=CuraBook

# ── JWT RSA Keys (F-12: RS256 Algorithm) ──────────────────────────────────────
# Generate keys first:  python backend/scripts/generate_jwt_keys.py
#
# Option A — inline PEM (Kubernetes secrets / AWS SSM / CI/CD pipelines):
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<base64>\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<base64>\n-----END PUBLIC KEY-----"
#
# Option B — path to mounted PEM files (Docker volumes / bare-metal):
# JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key.pem
# JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key.pem
#
# For development: leave blank — bundled keys in backend/certs/ are used automatically.
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=


# ── Data Retention (GDPR / Medical Records) ───────────────────────────────────
# Medical record retention in years (Egyptian MoH recommends 7 years minimum)
DATA_RETENTION_YEARS=7
# Audit log retention in years (GDPR recommends 3 years minimum)
AUDIT_LOG_RETENTION_YEARS=3

# ── Data Protection Officer ────────────────────────────────────────────────────
# Required before launch — set in your email templates / Privacy Policy
DPO_EMAIL=dpo@curabook.com

# ── Billing & Stripe ───────────────────────────────────────────────────────────
# Set BILLING_PROVIDER=mock for dev/staging (no real Stripe calls)
# Set BILLING_PROVIDER=stripe for production
BILLING_PROVIDER=mock

# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Get from https://dashboard.stripe.com/webhooks
# CLI: stripe listen --forward-to localhost:8000/api/v1/billing/webhook/stripe/
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Video Consultation ────────────────────────────────────────────────────────
# VIDEO_PROVIDER options: jitsi | daily
VIDEO_PROVIDER=jitsi
JITSI_DOMAIN=meet.jit.si
JITSI_SECRET=
# Daily.co (better quality):
# VIDEO_PROVIDER=daily
# DAILY_API_KEY=your-daily-api-key-from-dashboard.daily.co

# ─── Egyptian Payments (Paymob) ───────────────────────────────────────────────
# BILLING_PROVIDER=paymob  → Paymob (مصر)
# BILLING_PROVIDER=stripe  → Stripe (دولي)
# BILLING_PROVIDER=mock    → Development (no real payments)
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=
PAYMOB_FAWRY_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# ─── Egyptian SMS ──────────────────────────────────────────────────────────────
# SMS_PROVIDER options: vodafone_egypt | smsmisr | conneckio | console
# Vodafone Egypt:
# VODAFONE_EGYPT_API_KEY=
# VODAFONE_EGYPT_SENDER_ID=CuraBook
# SMS Misr:
# SMSMISR_USERNAME=
# SMSMISR_PASSWORD=
# SMSMISR_SENDER=CuraBook
# Conneckio:
# CONNECKIO_API_KEY=
# CONNECKIO_SENDER_ID=CuraBook

# ─── Database Backups ──────────────────────────────────────────────────────────
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=30
