# ─────────────────────────────────────────────────────────────────────────────
# CuraBook — Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Usage:
#   cp .env.example .env
#   nano .env        ← fill in your values
#
# This project uses Vite. All variables MUST be prefixed with VITE_
# to be accessible in the browser (import.meta.env.VITE_*)
# ─────────────────────────────────────────────────────────────────────────────

# ── Primary (Vite) — USE THESE ───────────────────────────────────────────────

# Backend API base URL — use a RELATIVE path in dev so Vite proxy handles it.
# Dev (no Docker):  /api/v1                           ← proxied to localhost:8000
# Dev (Docker):     /api/v1                           ← proxied to localhost:3080
# Prod:             https://yourdomain.com/api/v1
VITE_API_URL=/api/v1

# Proxy target — where the Vite dev server forwards /api/* and /ws/* requests.
# No Docker:  http://localhost:8000  (Django directly)
# Docker:     http://localhost:3080  (nginx in front of Django)
VITE_PROXY_TARGET=http://localhost:8000

# WebSocket URL — relative in dev, absolute in prod.
# Dev:  /ws
# Prod: wss://yourdomain.com/ws
VITE_WS_URL=/ws

# App metadata
VITE_APP_NAME=CuraBook
VITE_APP_VERSION=1.0.0

# Daily.co video API key (if VIDEO_PROVIDER=daily)
VITE_DAILY_DOMAIN=your-daily-domain.daily.co

# ── Legacy CRA compat (still accepted by config/env.js) ──────────────────────
# These are kept for backward compatibility only.
# New deployments should use VITE_* above.
# REACT_APP_API_URL=http://127.0.0.1:8000/api/v1
# REACT_APP_WS_URL=ws://127.0.0.1:8000/ws
# REACT_APP_NAME=CuraBook
# REACT_APP_VERSION=1.0.0
