# ─── CuraBook Frontend — Development Environment ─────────────────────────────
# Loaded when running: npm run dev  (overrides .env)
#
# FIX: VITE_API_URL is now a RELATIVE path (/api/v1) so every axios request
# goes to localhost:5173/api/... → Vite proxy forwards to Django on :8000.
# This means the proxy is ALWAYS used — no direct cross-origin calls from the
# browser, no CORS issues, no need for nginx in a local no-Docker setup.
#
# VITE_PROXY_TARGET controls where the Vite proxy sends requests:
#   No Docker  →  http://localhost:8000  (Django directly)
#   Docker     →  http://localhost:3080  (nginx in front of Django)

VITE_API_URL=/api/v1
REACT_APP_API_URL=/api/v1

VITE_WS_URL=/ws
REACT_APP_WS_URL=/ws

# FIX: proxy target now separate from API URL — no more fragile string-replace logic
VITE_PROXY_TARGET=http://localhost:8000

VITE_APP_NAME=CuraBook
VITE_APP_VERSION=1.0.0
REACT_APP_NAME=CuraBook
REACT_APP_VERSION=1.0.0
