{
  "name": "curabook",
  "version": "5.0.0",
  "private": true,
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "jspdf": "^2.5.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.563.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.9.6",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.6.0",
    "web-vitals": "^4.2.4"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .js,.jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:ci": "playwright test --reporter=github",
    "check:i18n": "node scripts/check-i18n-keys.js",
    "test:unit": "vitest run --reporter=verbose",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e:auth": "playwright test e2e/tests/auth.spec.js",
    "test:e2e:dash": "playwright test e2e/tests/doctor-dashboard.spec.js",
    "test:e2e:appt": "playwright test e2e/tests/appointments.spec.js",
    "test:e2e:records": "playwright test e2e/tests/patient-records.spec.js",
    "test:e2e:a11y": "playwright test e2e/tests/rtl-accessibility.spec.js",
    "test:e2e:rtl": "playwright test --project=rtl-arabic",
    "test:e2e:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:perf": "node tests/performance/benchmark.js",
    "test:perf:ci": "lhci autorun --config=tests/performance/lighthouserc.js",
    "test:load": "k6 run tests/load/load-test.js",
    "test:load:smoke": "k6 run tests/load/load-test.js --env K6_SCENARIO=smoke",
    "test:load:ws": "k6 run tests/load/websocket-load.js",
    "test:a11y": "node tests/accessibility/audit.js",
    "test:all": "npm run test:unit && npm run test:e2e && npm run test:a11y && npm run test:perf",
    "test:ci": "npm run test:unit:coverage && npm run test:e2e && npm run test:a11y",
    "test:setup": "node e2e/helpers/setup-auth.js",
    "test:install:pw": "npx playwright install --with-deps chromium firefox webkit",
    "test:e2e:analytics": "playwright test e2e/tests/analytics.spec.js",
    "test:e2e:notif": "playwright test e2e/tests/notifications.spec.js",
    "test:e2e:presc": "playwright test e2e/tests/prescriptions.spec.js",
    "test:e2e:profile": "playwright test e2e/tests/profile-settings.spec.js",
    "test:e2e:reports": "playwright test e2e/tests/reports.spec.js",
    "test:a11y:rtl": "node tests/accessibility/rtl-audit.js",
    "test:load:doctor": "k6 run tests/load/scenarios/doctor-flow.js",
    "test:e2e:setup": "playwright test e2e/tests/auth.setup.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.1",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.44.0",
    "@tanstack/react-query-devtools": "^5.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^25.0.0",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "type": "module",
  "description": "CuraBook — Complete Healthcare Platform (Phase 4 + Phase 5 Testing)"
}
