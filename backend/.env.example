# ─────────────────────────────────────────────────────────────────────────────
# CuraBook — Backend Environment Variables  (FIX E-07: expanded with all vars)
# ─────────────────────────────────────────────────────────────────────────────
# Usage:
#   cp .env.example .env
#   nano .env        ← fill in your values
#
# NEVER commit .env to version control — it contains secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Core ───────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=curabook.settings.dev

# Generate a strong secret key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-in-production
DJANGO_ENV=development
DEBUG=True

# Comma-separated allowed hostnames (production)
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_NAME=curabook_db
DB_USER=curabook_user
DB_PASSWORD=strong_password_here
DB_HOST=db           # "db" inside Docker Compose, "localhost" for local dev
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis     # "redis" inside Docker Compose, "localhost" for local dev
REDIS_PORT=6379

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Dev default: emails are printed to the console — no SMTP credentials needed.
#   To test real email delivery in dev, uncomment the lines below and fill them in.
#
# Prod: these are read automatically by settings/prod.py — fill them in for production.
#
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your_app_password_here
DEFAULT_FROM_EMAIL=CuraBook <noreply@curabook.com>

# ── CORS / CSRF ───────────────────────────────────────────────────────────────
# Dev default: if CORS_ALLOWED_ORIGINS is empty or not set, all origins are
#   allowed automatically (CORS_ALLOW_ALL_ORIGINS=True). No action needed for
#   local development unless you want to test strict CORS.
#
# To enable strict CORS in dev (mirrors production behaviour), uncomment and fill in:
# CORS_ALLOWED_ORIGINS=http://localhost:3080,http://127.0.0.1:3080
#
# Prod: required — set all origins that the frontend is served from.
CORS_ALLOWED_ORIGINS=http://localhost:3080,http://127.0.0.1:3080
CSRF_TRUSTED_ORIGINS=http://localhost:3080,http://127.0.0.1:3080

# ── Frontend URL (used in password-reset / email-verify links) ────────────────
FRONTEND_URL=http://localhost:3080

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_TIMEZONE=Africa/Cairo

# ── Sentry Error Tracking (optional — leave blank to disable) ─────────────────
# Get DSN from: https://sentry.io → Project → Settings → Client Keys
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
GIT_COMMIT_SHA=local

# ── Grafana monitoring dashboard ──────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_THIS_BEFORE_DEPLOY

# ── Timezone ──────────────────────────────────────────────────────────────────
USER_TIMEZONE=Africa/Cairo
